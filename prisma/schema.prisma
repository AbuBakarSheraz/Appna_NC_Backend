generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum MembershipType {
  STUDENT
  ANNUAL
  LIFETIME
}

enum Practicing {
  ACADEMICS
  NON_ACADEMICS
}

enum Prefix {
  DR
  MISS
  MR
  MRS
  MS
}

enum Suffix {
  DDS
  DMD
  DO
  MD
  NA
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum RegistrationFieldType {
  TEXT
  EMAIL
  PHONE
  NUMBER
  SELECT
  TEXTAREA
  CHECKBOX
  DATE
}

enum EventPaymentStatus {
  PENDING
  ORDER_CREATED
  PAID
  FAILED
  REFUNDED
  NOT_REQUIRED
}

enum TicketRequestStatus {
  PENDING_PAYMENT
  PAYMENT_COMPLETED
  AWAITING_ADMIN_CONFIRMATION
  CONFIRMED
  REJECTED
  CANCELLED
  EXPIRED
}

enum TicketStatus {
  VALID
  USED
  INVALIDATED
  EXPIRED
}

// ----------------------
// Main User Table
// ----------------------
model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  username           String   @unique
  password           String
  prefix             Prefix?
  suffix             Suffix?
  imagePath          String?
  isProfileCompleted Boolean  @default(false)
  profileStep        Int      @default(0) // Track multi-step completion
  isAdmin   Boolean  @default(false)
  createdAt          DateTime @default(now())

  // Relations
  refreshTokens     RefreshToken[]
  membership        Membership?
  basicInfo         BasicInfo?
  medicalEducation  MedicalEducation?
  address           Address?
  officeInformation OfficeInformation?
  eventRequests     TicketRequest[] @relation("EventRequester")
  reviewedTicketRequests TicketRequest[] @relation("EventRequestReviewer")
  eventTickets      Ticket[]        @relation("TicketOwner")
  checkedInTickets  Ticket[]        @relation("TicketChecker")
  notifications     Notification[]
}

enum NotificationAudience {
  USER
  ADMIN
}

enum NotificationType {
  PAYMENT_RECEIVED
  TICKET_APPROVED
  TICKET_REJECTED
  MEMBERSHIP_APPROVED
  MEMBERSHIP_EXPIRED
  NEW_REGISTRATION
  NEW_PAYMENT
  APPROVAL_REQUIRED
}

// ----------------------
// Refresh Tokens
// ----------------------
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------
// Membership
// ----------------------
model Membership {
  id                  String         @id @default(uuid())
  userId              String         @unique
  type                MembershipType
  price               Int
  isActive            Boolean        @default(true)
  startedAt           DateTime       @default(now())
  expiresAt           DateTime?
  paymentProvider     String?
  paymentStatus       String         @default("PENDING")
  paypalOrderId       String?        @unique
  paypalCaptureId     String?
  squarePaymentLinkId String?        @unique
  squareOrderId       String?        @unique
  squarePaymentId     String?
  paidAt              DateTime?
  paymentNotifiedAt   DateTime?
  expiredNoticeSentAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------
// Basic Info
// ----------------------
model BasicInfo {
  id            String         @id @default(uuid())
  userId        String         @unique
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  phoneNumber   String
  maritalStatus MaritalStatus?
  spouse        String?
  referredBy    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------
// Medical Education
// ----------------------
model MedicalEducation {
  id                  String      @id @default(uuid())
  userId              String      @unique
  institutionName     String
  graduationYear      Int
  primarySpecialty    String
  secondarySpecialty  String?
  internship          String?
  residency           String?
  fellowship1         String?
  fellowship2         String?
  currentlyPracticing Practicing?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------
// Address
// ----------------------
model Address {
  id        String  @id @default(uuid())
  userId    String  @unique
  street    String
  city      String
  state     String
  zipCode   String?
  country   String?
  homePhone String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------
// Office Information
// ----------------------
model OfficeInformation {
  id          String  @id @default(uuid())
  userId      String  @unique
  officeName  String
  street      String
  city        String
  state       String
  zipCode     String
  country     String
  officePhone String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id            String      @id @default(uuid())
  title         String
  slug          String      @unique
  description   String      @db.Text
  category      String
  bannerImage   String?
  date          DateTime
  startTime     String
  endTime       String
  venue         String
  googleMapsUrl String?
  capacity      Int
  ticketPrice   Int
  status        EventStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  registrationFields EventRegistrationField[]
  ticketRequests     TicketRequest[]
  tickets            Ticket[]
  auditLogs          EventAuditLog[]

  @@index([status, date])
  @@index([slug])
}

model EventRegistrationField {
  id        String                @id @default(uuid())
  eventId   String
  key       String
  label     String
  type      RegistrationFieldType @default(TEXT)
  required  Boolean               @default(false)
  options   Json?
  position  Int                   @default(0)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
  @@index([eventId, position])
}

model TicketRequest {
  id                String              @id @default(uuid())
  requestNumber     String              @unique
  eventId           String
  userId            String?
  fullName          String
  email             String
  phone             String
  cnic              String?
  city              String?
  organization      String?
  designation       String?
  answers           Json?
  paymentProvider   String?
  paymentStatus     EventPaymentStatus  @default(PENDING)
  paymentAmount     Int
  ticketQuantity    Int                 @default(1)
  paypalOrderId     String?             @unique
  paypalCaptureId   String?
  squarePaymentLinkId String?            @unique
  squareOrderId     String?              @unique
  squarePaymentId   String?
  paidAt            DateTime?
  approvalStatus    TicketRequestStatus @default(PENDING_PAYMENT)
  adminNotes        String?             @db.Text
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User?   @relation("EventRequester", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy User?   @relation("EventRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  tickets    Ticket[]

  @@index([eventId, approvalStatus])
  @@index([email])
  @@index([userId])
}

model Ticket {
  id                 String       @id @default(uuid())
  ticketNumber       String       @unique
  registrationNumber String       @unique
  requestId          String
  ticketIndex        Int          @default(1)
  eventId            String
  userId             String?
  attendeeName       String
  attendeeEmail      String
  qrPayloadHash      String       @unique
  qrSecret           String
  qrCodeDataUrl      String       @db.LongText
  ticketImageDataUrl String?      @db.LongText
  status             TicketStatus @default(VALID)
  issueDate          DateTime     @default(now())
  usedAt             DateTime?
  checkedInById      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  request     TicketRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User?         @relation("TicketOwner", fields: [userId], references: [id], onDelete: SetNull)
  checkedInBy User?         @relation("TicketChecker", fields: [checkedInById], references: [id], onDelete: SetNull)
  checkIns    TicketCheckIn[]

  @@index([eventId, status])
  @@index([requestId])
  @@index([userId])
  @@unique([requestId, ticketIndex])
}

model TicketCheckIn {
  id          String   @id @default(uuid())
  ticketId    String
  checkedInBy String?
  scannedAt   DateTime @default(now())
  result      String
  ipAddress   String?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, scannedAt])
}

model EventAuditLog {
  id        String   @id @default(uuid())
  eventId   String?
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([actorId, createdAt])
}

model Notification {
  id        String               @id @default(uuid())
  userId    String?
  audience  NotificationAudience
  type      NotificationType
  title     String
  message   String               @db.Text
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([audience, readAt, createdAt])
}
