generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enums
enum MembershipType {
  STUDENT
  ANNUAL
  LIFETIME
}

enum Practicing {
  ACADEMICS
  NON_ACADEMICS
}

enum Prefix {
  DR
  MISS
  MR
  MRS
  MS
}

enum Suffix {
  DDS
  DMD
  DO
  MD
  NA
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

// ----------------------
// Main User Table
// ----------------------
model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  username           String   @unique
  password           String
  prefix             Prefix?
  suffix             Suffix?
  imagePath          String?
  isProfileCompleted Boolean  @default(false)
  profileStep        Int      @default(0) // Track multi-step completion
  isAdmin   Boolean  @default(false)
  createdAt          DateTime @default(now())

  // Relations
  refreshTokens     RefreshToken[]
  membership        Membership?
  basicInfo         BasicInfo?
  medicalEducation  MedicalEducation?
  address           Address?
  officeInformation OfficeInformation?
}

// ----------------------
// Refresh Tokens
// ----------------------
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------
// Membership
// ----------------------
model Membership {
  id        String         @id @default(uuid())
  userId    String         @unique
  type      MembershipType
  price     Int
  isActive  Boolean        @default(true)
  startedAt DateTime       @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------
// Basic Info
// ----------------------
model BasicInfo {
  id            String         @id @default(uuid())
  userId        String         @unique
  firstName     String
  lastName      String
  dateOfBirth   DateTime?
  phoneNumber   String
  maritalStatus MaritalStatus?
  spouse        String?
  referredBy    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------
// Medical Education
// ----------------------
model MedicalEducation {
  id                  String      @id @default(uuid())
  userId              String      @unique
  institutionName     String
  graduationYear      Int
  primarySpecialty    String
  secondarySpecialty  String?
  internship          String?
  residency           String?
  fellowship1         String?
  fellowship2         String?
  currentlyPracticing Practicing?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------
// Address
// ----------------------
model Address {
  id        String  @id @default(uuid())
  userId    String  @unique
  street    String
  city      String
  state     String
  zipCode   String
  country   String
  homePhone String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------
// Office Information
// ----------------------
model OfficeInformation {
  id          String  @id @default(uuid())
  userId      String  @unique
  officeName  String
  street      String
  city        String
  state       String
  zipCode     String
  country     String
  officePhone String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
