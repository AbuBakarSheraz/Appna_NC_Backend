# ═════════════════════════════════════════════════════════════════
# APPNA NC Backend Configuration
# Copy this file to .env and fill in your actual values
# ═════════════════════════════════════════════════════════════════

# ─ DATABASE ──────────────────────────────────────────────────────
# MySQL connection string
DATABASE_URL=mysql://root:password@localhost:3306/appna_nc

# ─ SERVER ────────────────────────────────────────────────────────
# Port to run the backend on
PORT=1018

# Frontend URL (for CORS, redirects, etc)
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─ EMAIL (Gmail/Nodemailer) ──────────────────────────────────────
# Gmail account to send emails FROM
MAIL_USER=dev.appnanc@gmail.com

# Gmail app password (NOT your regular password)
# See: https://support.google.com/accounts/answer/185833
MAIL_PASS=your-app-password-here

# Organization inbox (where admin emails go)
MAIL_ORG=appnanc@gmail.com

# ─ JWT AUTHENTICATION ────────────────────────────────────────────
# Secret key for signing JWT tokens (make this long and random)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-recommended

# JWT token expiration (how long before user needs to re-login)
JWT_EXPIRATION=7d

# ─ PAYPAL PAYMENT INTEGRATION ────────────────────────────────────

# PayPal Environment
# Use 'sandbox' for testing, 'live' for real money
PAYPAL_ENV=sandbox

# Sandbox Credentials (for testing)
# Get these from: https://developer.paypal.com/ → Dashboard → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID_SANDBOX=your-sandbox-client-id-here
PAYPAL_CLIENT_SECRET_SANDBOX=your-sandbox-client-secret-here

# Live Credentials (for production - real payments)
# Get these from: https://developer.paypal.com/ → Dashboard → Apps & Credentials → Live
PAYPAL_CLIENT_ID_LIVE=your-live-client-id-here
PAYPAL_CLIENT_SECRET_LIVE=your-live-client-secret-here

# IMPORTANT: Use whichever matches your PAYPAL_ENV setting
# For sandbox testing:
PAYPAL_CLIENT_ID=${PAYPAL_CLIENT_ID_SANDBOX}
PAYPAL_CLIENT_SECRET=${PAYPAL_CLIENT_SECRET_SANDBOX}
# The backend also supports direct sandbox/live vars when PAYPAL_ENV is set.
# In other words, you can leave these unset and keep PAYPAL_CLIENT_ID_SANDBOX / PAYPAL_CLIENT_SECRET_SANDBOX.

# For production (change PAYPAL_ENV to 'live' and use these):
# PAYPAL_CLIENT_ID=${PAYPAL_CLIENT_ID_LIVE}
# PAYPAL_CLIENT_SECRET=${PAYPAL_CLIENT_SECRET_LIVE}

# ═════════════════════════════════════════════════════════════════
# MEMBERSHIP PRICING (can be overridden here if needed)
# These match the frontend PAYPAL_AMOUNTS constant
# ═════════════════════════════════════════════════════════════════
# RESIDENT_FELLOW_TRAINING_PRICE=0        # Free
# ANNUAL_MEMBERSHIP_PRICE=200              # $200 USD
# LIFETIME_MEMBERSHIP_PRICE=500            # $500 USD

# ═════════════════════════════════════════════════════════════════
# OPTIONAL: Logging and debugging
# ═════════════════════════════════════════════════════════════════
# DEBUG=true
# LOG_LEVEL=debug
