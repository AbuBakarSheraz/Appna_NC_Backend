# APPNA NC Backend Configuration
# Copy this file to .env and fill in the real values for each environment.

# Database
DATABASE_URL=mysql://root:password@localhost:3306/appna_nc

# Server
NODE_ENV=development
PORT=1018

# Public URLs
# FRONTEND_URL is used for PayPal return/cancel URLs and email links.
# BACKEND_PUBLIC_URL/APP_URL are used for public uploads and generated asset URLs.
# In production, do not leave these as localhost.
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:1018
APP_URL=http://localhost:1018

# Production examples:
# NODE_ENV=production
# FRONTEND_URL=https://appnanc.org
# BACKEND_PUBLIC_URL=https://api.appnanc.org
# APP_URL=https://api.appnanc.org

# CORS
# Comma-separated frontend origins that can call this API with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://appnanc.org,https://www.appnanc.org

# Email (Gmail/Nodemailer)
MAIL_USER=dev.appnanc@gmail.com
MAIL_PASS=your-gmail-app-password
MAIL_ORG=appnanc@gmail.com

# JWT authentication
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION=7d

# QR ticket signing
# Use a separate long random value in production. Falls back to JWT_SECRET if omitted.
QR_SIGNING_SECRET=Sheraz-02-03-2002

# PayPal
# Use sandbox for testing and live for real payments.
PAYPAL_ENV=sandbox

# Sandbox app credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID_SANDBOX=your-sandbox-client-id
PAYPAL_CLIENT_SECRET_SANDBOX=your-sandbox-client-secret

# Live app credentials from https://developer.paypal.com/dashboard/applications/live
PAYPAL_CLIENT_ID_LIVE=your-live-client-id
PAYPAL_CLIENT_SECRET_LIVE=your-live-client-secret

# Optional direct aliases. If omitted, the backend uses the sandbox/live values above.
# PAYPAL_CLIENT_ID=your-active-client-id
# PAYPAL_CLIENT_SECRET=your-active-client-secret

# PayPal webhooks for event payment capture backup.
# Configure this after creating the webhook in the PayPal Developer Dashboard.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Optional logging
# DEBUG=true
# LOG_LEVEL=debug
