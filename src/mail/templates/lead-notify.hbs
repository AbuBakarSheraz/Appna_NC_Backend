<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>New Contact Form Submission</title>
  <style>
    body { margin: 0; padding: 0; background: #f8f9fb; font-family: Arial, sans-serif; }
    .wrapper { max-width: 600px; margin: 40px auto; background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e5e7eb; }
    .header { background: #1f4d7a; padding: 28px 40px; }
    .header h1 { margin: 0; color: #ffffff; font-size: 20px; font-weight: 600; }
    .header p { margin: 4px 0 0; color: rgba(255,255,255,0.7); font-size: 13px; }
    .body { padding: 32px 40px; color: #374151; font-size: 15px; line-height: 1.7; }
    .field-row { margin-bottom: 18px; }
    .field-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #9ca3af; margin-bottom: 4px; }
    .field-value { font-size: 15px; color: #111827; }
    .message-box { background: #f8f9fb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px 18px; font-size: 14px; color: #374151; white-space: pre-wrap; line-height: 1.7; }
    .reply-btn { display: inline-block; margin-top: 24px; padding: 12px 28px; background: #1f4d7a; color: #ffffff; text-decoration: none; border-radius: 8px; font-size: 14px; font-weight: 600; }
    .divider { border: none; border-top: 1px solid #e5e7eb; margin: 24px 0; }
    .footer { background: #f8f9fb; padding: 18px 40px; text-align: center; font-size: 12px; color: #9ca3af; border-top: 1px solid #e5e7eb; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>📬 New Contact Form Submission</h1>
      <p>Received on {{submittedAt}}</p>
    </div>

    <div class="body">
      <div class="field-row">
        <div class="field-label">Full Name</div>
        <div class="field-value">{{fullName}}</div>
      </div>

      <div class="field-row">
        <div class="field-label">Email</div>
        <div class="field-value"><a href="mailto:{{email}}" style="color:#1f4d7a;">{{email}}</a></div>
      </div>

      <div class="field-row">
        <div class="field-label">Subject</div>
        <div class="field-value">{{subject}}</div>
      </div>

      <hr class="divider" />

      <div class="field-label">Message</div>
      <div class="message-box">{{message}}</div>

      <a href="mailto:{{email}}?subject=Re: {{subject}}" class="reply-btn">
        Reply to {{fullName}}
      </a>
    </div>

    <div class="footer">
      <p>© {{year}} APPNA NC — this email was generated automatically from the website contact form.</p>
    </div>
  </div>
</body>
</html>
